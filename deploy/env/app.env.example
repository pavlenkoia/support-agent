APP_NAME=support-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://support_agent:support_agent@db:5432/support_agent
DIRECT_LLM_PROVIDER=stub
DIRECT_LLM_MODEL=stub
HERMES_BACKEND_ENABLED=false
HERMES_BACKEND_MODE=stub
KNOWLEDGE_BACKEND=filesystem
KNOWLEDGE_ROOT=/data/support-agent-kb
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_POLL_INTERVAL_SECONDS=3
TELEGRAM_POLL_OFFSET_FILE=/app/logs/telegram-update-offset.txt
VK_ENABLED=false
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_LONGPOLL_WAIT_SECONDS=25
VK_POLL_INTERVAL_SECONDS=3
VK_POLL_STATE_FILE=/app/logs/vk-longpoll-state.json
VK_REQUEST_TIMEOUT_SECONDS=30
VK_MAX_RETRIES=3
VK_RETRY_BACKOFF_SECONDS=1.0
VK_OVERRIDE_SILENCE_SECONDS=3600
VIEWER_TIMEZONE=Asia/Yekaterinburg
VIEWER_AUTH_ENABLED=false
VIEWER_AUTH_KEY=
VIEWER_AUTH_COOKIE_NAME=viewer_auth
VIEWER_AUTH_SESSION_DAYS=365
VIEWER_AUTH_COOKIE_SECURE=false
VIEWER_PUSH_ENABLED=false
VIEWER_PUSH_VAPID_PUBLIC_KEY=
VIEWER_PUSH_VAPID_PRIVATE_KEY=
VIEWER_PUSH_VAPID_SUBJECT=mailto:admin@example.com
VIEWER_PUSH_POLL_INTERVAL_SECONDS=5
# Aggressive delivery: FCM/Web Push stores high-priority messages for one day;
# stuck worker leases are reclaimed after 90 seconds and delivery is retried.
VIEWER_PUSH_TTL_SECONDS=86400
VIEWER_PUSH_URGENCY=high
VIEWER_PUSH_PROCESSING_LEASE_SECONDS=90
LOG_LEVEL=INFO
